# ── Copy this to .env and fill in your values ──────────────────────────────

# MongoDB — add username:password if you set up auth
MONGODB_URI=mongodb://localhost:27017/code-learner

# JWT — CHANGE THIS to a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# Judge0 self-hosted URL (required on offline server — ce.judge0.com won't work)
# After running Judge0 with docker compose, uncomment:
JUDGE0_URL=http://localhost:2358/submissions?base64_encoded=false&wait=true

# Redis — Judge0 starts one on port 6379; reuse it for rate limiting
REDIS_URL=redis://localhost:6379

# Frontend origin for CORS (your server's LAN IP, port 80 via nginx)
# Multiple origins: comma-separated
FRONTEND_URL=http://192.168.1.100

# Ollama (already running locally)
OLLAMA_URL=http://localhost:11434/api/generate

# Port for Node backend (nginx proxies to this)
PORT=5001
